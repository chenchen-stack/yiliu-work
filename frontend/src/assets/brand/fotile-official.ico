<script>



    // fss埋码
    let fssName =  document.getElementsByTagName('meta')['fssName'].content;
    if(fssName){
        var _map = _map || [];
        _map.push(['_setPt', fssName]);
        (function () {
            var ma = document.createElement('script');
            ma.type = 'text/javascript';
            ma.async = true;
            ma.src = '/webstatic/Public/Home/js/buried.js';
            var s = document.getElementsByTagName('script')[0];
            s.parentNode.insertBefore(ma, s);
        })();
    }
    function getQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
        var r = window.location.search.substr(1).match(reg);
        if (r != null)
            //return unescape(r[2]);//会中文乱码
            return decodeURI((r[2]));//解决了中文乱码
        return null;
    }
    function generateRandom() {
        return Math.random().toString(16).slice(2);
    }

    setTimeout(sendgioUser(),1000)
    function sendgioUser(){
        let userId= $.cookie('userId');
        if(!userId){
            let userId= generateRandom();
            $.cookie('userId',userId);
            let date = new Date();
            let year = date.getFullYear();
            let month = date.getMonth() + 1;
            let day = date.getDate();

            month = (month > 9) ? month : ("0" + month);
            day = (day < 10) ? ("0" + day) : day;
            let today = year + "-" + month + "-" + day;
            gdp('setUserAttributes', {
                visitId_vstr:userId?userId:'-',//访问用户ID
                ifFirstVisit_vstr:true,//是否首次访问
                ifHistoryRetainUser_vstr:false,//是否历史留资用户
                firstRetainDate_vstr:today,//首次留资日期
            });
        }else{
            gdp('setUserAttributes', {
                visitId_vstr:userId?userId:'-',//访问用户ID
                ifFirstVisit_vstr:false,//是否首次访问
                ifHistoryRetainUser_vstr:true,//是否历史留资用户
                firstRetainDate_vstr:'-',//首次留资日期
            });
        }
        console.log(userId)
    }

</script>
</head>
<body>
<script>
    // 请在标签body之后加载
    (function (w, d, n, a, j) {
        w[n] = w[n] || function () {
            (w[n].a = w[n].a || []).push(arguments)
        };
        j = d.createElement('script');
        j.async = true;
        j.src = 'https://qiyukf.com/script/c8f4a5cb93d7b53c07a3467875022e64.js?subdomain=1';
        d.body.appendChild(j);
    })(window, document, 'ysf');

    // 设置用户身份
    ysf('onready', function () {
        ysf('config', {
            wp:1,
            robotShuntSwitch:1,
            robotId:5286982,
            groupid: '481839794'//客服组
        })
    })
    // 以商品链接打开客服
    function ysf_open_product(type) {
        ysf('product', {
            show: 1, // 1为打开， 其他参数为隐藏（包括非零元素）
            title: '标题',
            desc: '商品描述',
            picture: 'https://hsimage.fotile.com/202201201404165821846.jpg',
            note: `市场价：100           售价：10`,
            url: 'https://hsadmin.fotile.com/backend/#/devops/issue/manage',
            sendByUser: 1,
            price: '100',
            success: function () {     // 成功回调
                ysf('open');
            },
            error: function () {       // 错误回调
            }
        })
    }

    // 直接打开客服
    function ysf_open(type) {
        //ysf('open');
       
        gdp('track', 'FT_customerServiceEntranceClick ', {
            utmSource_var: getQueryString('utm_source')?getQueryString('utm_source'):'-',//广告来源
            pageName_var: '-',//页面名称
            pageUrl_var: window.location.href,//页面地址
        });
         window.open('/help/qiyukf.html')
    }

</script>
