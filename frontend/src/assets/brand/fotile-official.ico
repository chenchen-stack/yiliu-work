<script src="https://lib.baomitu.com/vue/2.5.17/vue.min.js"></script>

<script src="/webstatic/common/pc/js/global.js"></script>
<script>
    var mydate=new Date();
    function setShowFn(item){
        document.getElementById('loadMores').style.display='none'
        document.getElementById('isShows').style.display='block'
    }
    var year =mydate.getFullYear();
    $('.year').text(year);

    function gioBottom(idx,name){
        switch(idx){
           case 2:
               ysf_open();
               break;
            case 1:
                openStore()
                break;
        }
        gdp('track', 'FT_flowClick', {
            utmSource_var: getQueryString('utm_source')?getQueryString('utm_source'):'-',//广告来源
            pageName_var: _moduleName,//页面名称
            pageUrl_var: window.location.href,//页面地址
            moduleName_var: '悬浮窗',//模块名称
            positionNumber_var: idx,//坑位
            pitName_var: name,//流量位名称
            frame_var: '-',//帧
            bannerNum_var:'-',
        });
    }

    function trackLog(pitName_var) {
        gdp('track', 'FT_flowClick', {
        utmSource_var:getQueryString('utm_source')?getQueryString('utm_source'):'-',//广告来源
        pageName_var: _module,//页面名称
        pageUrl_var: window.location.href,//页面地址
        tabName_var: '-',
        moduleName_var: '底部',//模块名称
        positionNumber_var: '-',//坑位
        frame_var: '-',//帧数
        bannerNum_var:'-', // 上报点击所在的banner位置，如1，2，3
        pitName_var: pitName_var,//流量位名称
        });
    }
    //附近门店
    function  openStore(){
        window.location.href='/service/city/queryCity.html'
    }

    function getAdver(){
        $.ajax({
            method: 'GET',
            url: "/common/getCustomAdvert?codes=pc-ow-footer-001",
            success: (res)=>{
                if(res.success){
                    // console.log(res.data['pc-ow-footer-001'][0].abstractNote)
                    $(".tipTxt2").html(res.data['pc-ow-footer-001'][0].abstractNote);





                    const richTextContainer = document.getElementById("footerContent");
                    const content = document.getElementById("footerContent");
                    const loadMoreButton = document.getElementById("load-more");
                    const footerAllContent=document.getElementById("footerAllContent");
                    // 检查内容高度是否超过最大高度
                    if (content.scrollHeight > richTextContainer.clientHeight) {
                        loadMoreButton.style.display = "block"; // 显示加载更多按钮
                    }

                    // 点击加载更多按钮时展开全部内容
                    loadMoreButton.addEventListener("click", function() {

                        loadMoreButton.style.display = "none"; // 隐藏加载更多按钮
                        footerAllContent.style.display= "block";
                        content.style.display='none'
                    });
                }
                // console.log(555,res.data)
            },
            error: function(){
            }
        });

    }
    getAdver()

    $('.myqrcode1').hide()
    $('.myqrcode2').hide()

</script>
