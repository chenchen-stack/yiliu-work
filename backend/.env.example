# DeepSeek API（也可在管理后台「系统配置 → 大模型配置」中填写，DB 优先于 .env）
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# false = 使用 DeepSeek 真实 AI 归因
USE_MOCK_AI=false

# 生产对话开放问答走 Skill Agent（ReAct + SSE）
USE_PLATFORM_CHAT_SSE=true
# 有 API Key 时可开启 LangGraph 原生 tool calling
# USE_LANGGRAPH_AGENT=true
